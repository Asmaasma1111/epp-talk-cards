{
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
      { "key": "X-Robots-Tag", "value": "noindex" },
      { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
    ] },
    { "source": "/sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/config.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/levels/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
    { "source": "/audio/voice.json", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
